# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://alibi_app:CHANGE_ME@localhost:5432/alibi
MIGRATION_DATABASE_URL=postgresql+psycopg://alibi_owner:CHANGE_ME@localhost:5432/alibi
TEST_DATABASE_URL=postgresql+psycopg://alibi_app:CHANGE_ME@localhost:5432/alibi_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://alibi_owner:CHANGE_ME@localhost:5432/alibi_test
# Held-out eval database (reset by `make eval`; name must contain 'eval').
EVAL_DATABASE_URL=postgresql+psycopg://alibi_app:CHANGE_ME@localhost:5432/alibi_eval
EVAL_MIGRATION_DATABASE_URL=postgresql+psycopg://alibi_owner:CHANGE_ME@localhost:5432/alibi_eval
ATTACHMENT_KEY_SECRET=CHANGE_ME_long_random_string
# Model explanations (D-022). Off by default; decisions never depend on them.
LLM_ENABLED=false
# Only "vertex" (Gemini on Vertex AI) is implemented.
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=CHANGE_ME_project_id
GOOGLE_CLOUD_LOCATION=CHANGE_ME_region
# A Gemini model enabled in that project and region (README: "Model explanations").
LLM_MODEL=CHANGE_ME_model_id
# Local/dev only: path to a service-account key file OUTSIDE this repository, or leave it
# empty to use Application Default Credentials (gcloud auth application-default login).
# Production uses the Cloud Run service identity instead (DEPLOY.md).
GOOGLE_APPLICATION_CREDENTIALS=
# Prices in USD per million tokens, copied from the Vertex AI pricing page for LLM_MODEL.
# Empty means no cost estimate is recorded.
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
# API keys for POST /agent: comma-separated org_id:sha256-of-key. Hashes only, never keys.
# Make one with: cd backend && uv run alibi api-key --org org_demo_alpha
# Empty means POST /agent answers 401 to every request. Example shape:
# ALIBI_API_KEYS=org_demo_alpha:<64 hex chars>,org_demo_bravo:<64 hex chars>
ALIBI_API_KEYS=
