#!/usr/bin/env python3
"""Checks every relative markdown link and image path, and every relative src/srcset in raw
HTML (e.g. a <picture> banner), in README.md, ARCHITECTURE.md, DEPLOY.md and docs/**/*.md
resolves to a real file. Skips http(s):// and mailto: links and bare #anchors within the same
file. Does not check that a #heading anchor exists (that needs a markdown parser matching
GitHub's slug algorithm; out of scope here)."""

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
FILES = [REPO_ROOT / "README.md", REPO_ROOT / "ARCHITECTURE.md", REPO_ROOT / "DEPLOY.md"]
FILES += sorted((REPO_ROOT / "docs").rglob("*.md"))

LINK = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
HTML_SRC = re.compile(r'\b(?:src|srcset)="([^"]+)"')


def targets(text: str) -> list[str]:
    out = []
    for m in LINK.finditer(text):
        target = m.group(1).strip()
        if " " in target:  # a title after the URL, e.g. (path "title")
            target = target.split(" ", 1)[0]
        out.append(target)
    for m in HTML_SRC.finditer(text):
        out.append(m.group(1).strip().split(" ", 1)[0])  # srcset may carry a density, e.g. "x 2x"
    return out


def main() -> int:
    problems: list[str] = []
    checked = 0
    for path in FILES:
        if not path.is_file():
            continue
        for target in targets(path.read_text(encoding="utf-8")):
            if target.startswith(("http://", "https://", "mailto:")):
                continue
            if target.startswith("#"):
                continue  # same-file anchor; not checked (see module docstring)
            file_part = target.split("#", 1)[0]
            if not file_part:
                continue
            resolved = (path.parent / file_part).resolve()
            checked += 1
            if not resolved.exists():
                problems.append(f"{path.relative_to(REPO_ROOT)}: {target!r} -> {resolved} does not exist")
    if problems:
        for p in problems:
            print(f"BROKEN  {p}")
        print(f"check-links: {len(problems)} broken link(s) of {checked} checked")
        return 1
    print(f"check-links: all {checked} relative links resolve")
    return 0


if __name__ == "__main__":
    sys.exit(main())
