#!/usr/bin/env bash
# One command for the review UI against the local API (dev only): `make review-ui`.
#   1. migrates the database (DATABASE_URL etc. come from the Makefile defaults or .env);
#   2. decides the sample fee report for both demo orgs, once, if an org has no run yet
#      (data/ sample files only; never eval/ data);
#   3. starts the API on :8000 with two dev-only API keys (hashes only in ALIBI_API_KEYS);
#   4. starts the UI on :3000 and prints the keys to sign in with. Ctrl-C stops both.
# The dev keys are like the dev database passwords: local only, never for a deployment.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
API_PORT="${API_PORT:-8000}"
ALPHA_KEY="${ALIBI_DEV_KEY_ALPHA:-dev-only-alpha-review-key}"
BRAVO_KEY="${ALIBI_DEV_KEY_BRAVO:-dev-only-bravo-review-key}"

cd "$ROOT/backend"
# Dev only: refuse to write demo runs into anything but a local database.
db_host="$(uv run python -c '
from sqlalchemy.engine import make_url
from app.core.config import get_settings
print(make_url(get_settings().database_url).host or "")
')"
case "$db_host" in
  localhost|127.0.0.1|::1) ;;
  *) echo "review-ui: DATABASE_URL host is '$db_host', not local; refusing (dev only)" >&2; exit 2 ;;
esac
uv run alembic upgrade head

ALIBI_API_KEYS="$(uv run python -c '
import sys
from app.api.auth import hash_key
print(f"org_demo_alpha:{hash_key(sys.argv[1])},org_demo_bravo:{hash_key(sys.argv[2])}")
' "$ALPHA_KEY" "$BRAVO_KEY")"
export ALIBI_API_KEYS

for org in org_demo_alpha org_demo_bravo; do
  runs="$(uv run python -c '
import sys
from app.db import repo
from app.db.session import get_engine, org_session
with org_session(get_engine(), sys.argv[1]) as s:
    print(len(repo.list_runs(s)))
' "$org")"
  if [ "$runs" = "0" ]; then
    echo "review-ui: deciding the sample report for $org"
    uv run alibi run --report ../data/fee_report_sample.csv --upstream ../data/upstream/ \
      --org "$org" >/dev/null
  fi
done

uv run uvicorn app.main:app --host 127.0.0.1 --port "$API_PORT" &
API_PID=$!
trap 'kill "$API_PID" 2>/dev/null || true' EXIT INT TERM

for _ in $(seq 1 60); do
  if curl -fsS "http://localhost:$API_PORT/health" >/dev/null 2>&1; then break; fi
  sleep 0.5
done
curl -fsS "http://localhost:$API_PORT/health" >/dev/null || {
  echo "review-ui: the API did not become healthy on :$API_PORT" >&2
  exit 1
}

cd "$ROOT/frontend"
# Install when node_modules is missing or older than the lockfile (npm writes
# node_modules/.package-lock.json on every install), so a pull that adds packages is picked up.
if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
  npm ci
fi
cat <<EOF

  Review UI:  http://localhost:3000
  Sign in with one of these dev-only keys:
    org_demo_alpha  $ALPHA_KEY
    org_demo_bravo  $BRAVO_KEY

EOF
ALIBI_BACKEND_URL="http://localhost:$API_PORT" npm run dev -- -H 127.0.0.1
